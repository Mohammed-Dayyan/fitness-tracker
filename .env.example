# Copy to .env and fill in. Never commit .env.

# --- Local Postgres (docker compose) ---------------------------------------
# Password for the local container; pick any value. Used by docker-compose.yml
# and must match the password inside the two URLs below.
POSTGRES_PASSWORD="change-me-local-only"
# Host port for the local container (127.0.0.1 only). If you change it, change
# the port in the URLs below too.
POSTGRES_PORT=5434

# --- Database connections ----------------------------------------------------
# The app reads only DATABASE_URL. Any PostgreSQL host works (local Docker,
# Supabase, Neon, RDS...); switching providers means changing these URLs only.
DATABASE_URL="postgresql://fitness:change-me-local-only@localhost:5434/fitness?schema=public"

# Optional. Direct (non-pooled) URL used only by `prisma migrate`. Set it when
# DATABASE_URL points at a transaction pooler (Supabase port 6543, Neon -pooler).
# DIRECT_DATABASE_URL="postgresql://..."

# Separate database used only by `npm test`. Its name MUST end in _test:
# the test setup refuses to run against anything else because it wipes tables.
TEST_DATABASE_URL="postgresql://fitness:change-me-local-only@localhost:5434/fitness_test?schema=public"

# --- Auth --------------------------------------------------------------------
# Secret used to sign access-token JWTs. At least 32 random characters, e.g.
#   openssl rand -base64 48
# Changing it signs everyone out of their current access token (refresh tokens
# then issue new ones).
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Refresh-token lifetime in days (sliding: each refresh issues a new token).
SESSION_TTL_DAYS=30

# --- Email (confirmation codes) ----------------------------------------------
# Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it here (NOT your Google
# password). Without SMTP_USER/SMTP_PASSWORD, development prints the code to
# the server console instead of sending; production refuses to send.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
# MAIL_FROM="Fitness Tracker <you@gmail.com>"

# --- Proxy / origin ----------------------------------------------------------
# Optional. Public origin of the app, e.g. https://fitness.example.com. When
# set, the CSRF check compares the request's Origin header against it exactly.
# APP_ORIGIN="https://fitness.example.com"

# TRUST_PROXY: leave "false" unless EVERY request reaches the app through a
# proxy you control that overwrites or appends X-Forwarded-For (Vercel does).
# When "true", login rate limiting keys on the LAST X-Forwarded-For entry (the
# one your proxy wrote) and X-Forwarded-Host/-Proto are trusted for the CSRF
# check. If the app is reachable directly, clients could forge these headers,
# so keep it "false": all clients then share one rate-limit bucket.
# Locked out? Run `npm run unlock-login` (needs database access).
TRUST_PROXY=false
